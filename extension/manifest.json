{
  "manifest_version": 3,
  "name": "Job Apply Assist Prefill",
  "version": "0.1.0",
  "description": "Fills visible application fields from your Job Assist session. Never submits forms.",
  "permissions": ["activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Fill fields from Job Assist" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["portal.js", "target.js"],
      "run_at": "document_idle"
    }
  ]
}
