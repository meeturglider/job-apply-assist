# Local web app
APP_HOST=127.0.0.1
APP_PORT=8765
LOG_LEVEL=INFO

# Sharing safety: blank disables auth. With a password set, use any username.
SHARED_PASSWORD=
RATE_LIMIT_PER_MINUTE=30
TRUST_PROXY_HEADERS=false

# Private portal mode: per-user accounts with session-only candidate data.
# Set SESSION_COOKIE_SECURE=true when the tunnel URL is HTTPS.
PORTAL_MODE=false
ALLOW_REGISTRATION=true
SESSION_TTL_MINUTES=480
SESSION_COOKIE_SECURE=false

# LLM provider: ollama (default) or none (deterministic fallback only)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_MAX_RETRIES=1
OLLAMA_RETRY_BACKOFF_SECONDS=1
# Raise these if long resume JSON responses are truncated by the model.
OLLAMA_NUM_CTX=32768
OLLAMA_MAX_PREDICT=8192

# Fast local NLP stage: none, gliner, or off. Install with `pip install -e '.[nlp]'`.
NLP_PROVIDER=none
NLP_MODEL=gliner-community/gliner_small-v2.5
# Set a local directory to load cached weights without network access.
NLP_MODEL_PATH=
NLP_MAX_CHARS=24000
NLP_CHUNK_CHARS=4000
NLP_CANDIDATE_LIMIT=80
NLP_THRESHOLD=0.4

# Candidate sources
MASTER_RESUME_PATH=MASTER_RESUME.md
PORTFOLIO_BASE_URL=https://hari.is-a.dev
PORTFOLIO_CACHE_SECONDS=3600

# Storage
DATA_DIR=data
